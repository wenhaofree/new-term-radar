# Copy to .env and fill in. Never commit .env.

# Required for paid signals (X via AIsa fallback, Trends, keyword table, name judge)
AISA_API_KEY=

# Optional enrichment (related queries, country trends, page-one DR)
GOANYAPI_API_KEY=

# Optional weekly revenue signal (TrustMRR); required when using --revenue
TRUSTMRR_API_KEY=

# Product database for the frontend.
# Production (radar container on wenhao-services → wenhao-postgres; SSL on; NO host port):
DATABASE_URL=postgresql://radar:CHANGE_ME@wenhao-postgres:5432/radar?sslmode=require
# Do NOT use 127.0.0.1 from inside the radar container — Postgres is not published to the host.
# Local compose Postgres (profile local-db, from the host):
# DATABASE_URL=postgresql://radar:radar@127.0.0.1:5432/radar

# Alerts: Feishu / DingTalk / Telegram / generic JSON webhook
RADAR_WEBHOOK_URL=
# feishu | dingtalk | telegram | generic  (auto-detected from URL when unset)
RADAR_WEBHOOK_TYPE=feishu

# Optional email report (Resend)
RESEND_API_KEY=
EMAIL_FROM=
RADAR_EMAIL_TO=

# Optional
GITHUB_TOKEN=
